# ==============================================================================
# MOTRIK - Variables de Entorno de Ejemplo
# Copia este archivo a .env.local para configurar tu entorno de desarrollo
# ==============================================================================

# URL de tu instancia de Supabase (requerido para modo Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (Anon Key / Publishable Key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_clave_anonima_o_publishable

# Modo de origen de datos: 'auto' | 'supabase' | 'mock'
# - auto: Detecta credenciales válidas; en desarrollo recurre a mock si falla
# - supabase: Modo estricto para producción (lanza error explícito si falla la BD)
# - mock: Fuerza uso de datos simulados locales sin realizar llamadas de red
NEXT_PUBLIC_DATA_SOURCE=auto
